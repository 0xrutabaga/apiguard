# Copy to .env (git-ignored) or export these variables. apiguard reads APIGUARD_* variables.
# production (default) and development both refuse a weak or placeholder signing key;
# only "test" accepts one.
APIGUARD_ENVIRONMENT=development
APIGUARD_DATABASE_URL=postgresql+psycopg://apiguard:apiguard@127.0.0.1:55431/apiguard
# Generate your own: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
APIGUARD_JWT_SIGNING_KEY=replace-with-output-of-the-command-above
APIGUARD_JWT_ISSUER=apiguard
APIGUARD_JWT_AUDIENCE=apiguard-api
APIGUARD_ACCESS_TOKEN_TTL_SECONDS=300
APIGUARD_REFRESH_TOKEN_TTL_SECONDS=1209600
# Comma-separated list. Empty means CORS is off (no Access-Control-* headers are sent).
APIGUARD_CORS_ORIGINS=
